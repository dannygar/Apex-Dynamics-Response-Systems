# Public SPA configuration only. Copy these entries to .env.local.
# Never add client secrets, storage credentials, tokens or Foundry keys here.
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_API_SCOPE=

# Backend (API/worker) settings are process environment variables, NOT Vite variables.
# They are listed here for reference only; see services/evaluation/README.md.
#   ConnectionStrings__Evaluation   SQLite path or SQL Server (managed identity: Authentication=Active Directory Managed Identity;User Id=<client id>)
#   Database__Provider              SqlServer | (default) Sqlite
#   Storage__Provider               Local | AzureBlob
#   Storage__Root                   Local private directory (Local provider)
#   Storage__ContainerUri           https://<account>.blob.core.windows.net/<existing-container> (AzureBlob, no SAS)
#   AZURE_CLIENT_ID                 User-assigned managed identity client ID (DefaultAzureCredential)
#   Entra__TenantId / Entra__Audience / Entra__RequiredScope   API token validation
#   Malware__ClamAvHost / Malware__ClamAvPort                  Worker ClamAV INSTREAM (default port 3310)
#   Judge__SidecarUrl               Worker only, e.g. http://127.0.0.1:8081 (unset = judge fails closed)
#   Judge__RequestTimeoutMinutes    Worker per-call judge timeout, default 10
